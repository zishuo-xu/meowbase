{
  "name": "meowbase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "smoke": "pnpm --filter @meowbase/api build && tsx scripts/smoke.ts",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "e2e": "tsx scripts/e2e.ts",
    "eval": "tsx scripts/eval.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
